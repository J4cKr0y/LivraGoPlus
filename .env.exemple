# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:YYY # team: kiky270281, project: livragoplus

EXPO_PUBLIC_CONVEX_URL=https://XXX.eu-west-1.convex.cloud

EXPO_PUBLIC_CONVEX_SITE_URL=https://XXX.eu-west-1.convex.site

# API Key Resend found here : https://resend.com/onboarding and do : npx convex env set RESEND_API_KEY re_xxxxxxxxxxxxxxxx

# Switch between wepb or jpg, so you can choose in function of the backend
EXPO_PUBLIC_WEBP_ENABLED=true